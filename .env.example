# All Pro Charter — Lead Manager · environment template
# Copy to .env for local dev (.env is gitignored). Set real values in the host config for prod.

# --- Django ---
DJANGO_SECRET_KEY=change-me            # gen: python -c "from django.core.management.utils import get_random_secret_key as k;print(k())"
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/New_York
DJANGO_LOG_LEVEL=INFO

# ngrok tunnel host for Podium OAuth callback + webhooks over HTTPS (dev only)
NGROK_HOST=                            # e.g. your-subdomain.ngrok-free.dev

# --- Database --- (SQLite is used by default in dev when unset)
# DATABASE_URL=mysql://apc:password@localhost:3306/apc

# --- Scheduled jobs (cron-job.org POSTs /cron/<job>/ with this header value) ---
CRON_SECRET=                           # X-Cron-Key header value; blank disables the endpoints

# --- Stripe (deposits + balance) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEPOSIT_PCT=50
BALANCE_CHARGE_DAYS_BEFORE=30

# --- Podium (messaging — OAuth 2.0 authorization-code) ---
PODIUM_CLIENT_ID=
PODIUM_CLIENT_SECRET=
PODIUM_REDIRECT_URI=                   # https://<NGROK_HOST>/integrations/podium/callback/  (prod: https://leads.allprocharter.com/integrations/podium/callback/)
PODIUM_ORGANIZATION_UID=
PODIUM_LOCATION_UID=
PODIUM_WEBHOOK_SECRET=
# PODIUM_SCOPES defaults to: read_messages,write_messages,read_contacts,write_contacts,read_reviews,write_reviews

# --- LimoAnywhere Customer API (unset LA_CLIENT_ID = preview mode, payload previews only) ---
LA_BASE_URL=https://api.mylimobiz.com
LA_CLIENT_ID=
LA_CLIENT_SECRET=
LA_COMPANY_ALIAS=
LA_PAYMENT_TYPE_ID=0                   # pick the non-charging type via manage.py la_smoke_test
LA_WEBHOOK_BASE_URL=                   # public base for LA webhooks, e.g. https://<NGROK_HOST>

# --- LocationIQ (geocoding — LA requires lat/lng on every address) ---
LOCATIONIQ_API_KEY=

# --- Inbound capture API ---
LEAD_INBOUND_API_KEY=

# --- Touch-points / messaging ---
QUOTE_EXPIRY_DAYS_BEFORE_PICKUP=14
TOUCHPOINTS_ENABLED=False                # dev safety: off by default; enable only for local testing
COMPANY_NAME=All Pro Charter
COMPANY_PHONE=
COMPANY_EMAIL=
PUBLIC_BASE_URL=                       # public https base of the portal, e.g. https://<NGROK_HOST> in dev; required for touch-point quote links

# --- Email (SMTP) — dev uses the console backend regardless ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=All Pro Charter <noreply@allprocharter.com>
EMAIL_TIMEOUT=10
