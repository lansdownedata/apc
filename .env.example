# All Pro Charter — Lead Manager · environment template
# Copy to .env for local dev (.env is gitignored). Set real values in the host config for prod.

# --- Django ---
DJANGO_SECRET_KEY=change-me            # gen: python -c "from django.core.management.utils import get_random_secret_key as k;print(k())"
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/New_York
DJANGO_LOG_LEVEL=INFO

# ngrok tunnel host for Podium OAuth callback + webhooks over HTTPS (dev only)
NGROK_HOST=                            # e.g. your-subdomain.ngrok-free.dev

# --- Database --- (SQLite is used by default in dev when unset)
# DATABASE_URL=mysql://apc:password@localhost:3306/apc

# --- Scheduled jobs (cron-job.org POSTs /cron/<job>/ with this header value) ---
CRON_SECRET=                           # X-Cron-Key header value; blank disables the endpoints

# --- Stripe (deposits + balance) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEPOSIT_PCT=50
BALANCE_CHARGE_DAYS_BEFORE=30

# --- Podium (messaging — OAuth 2.0 authorization-code) ---
PODIUM_CLIENT_ID=
PODIUM_CLIENT_SECRET=
PODIUM_REDIRECT_URI=                   # https://<NGROK_HOST>/integrations/podium/callback/  (prod: https://leads.allprocharter.com/integrations/podium/callback/)
PODIUM_ORGANIZATION_UID=
PODIUM_LOCATION_UID=
PODIUM_WEBHOOK_SECRET=
# PODIUM_SCOPES defaults to: read_messages,write_messages,read_contacts,write_contacts,read_reviews,write_reviews

# --- LimoAnywhere Customer API ---
# Preview mode (payload previews only, nothing sent) unless BOTH LA_ACTIVE=True and the
# credentials below are set. LA_BASE_URL defaults to PRODUCTION, so a send books a real
# reservation in the client's LimoAnywhere account — LA_ACTIVE=True arms that, deliberately,
# when Phase 1 lands. While it is off, every skipped send is logged and kept as a PREVIEW
# event, and is replayed by the retry-la-sync cron once armed.
LA_ACTIVE=False
LA_BASE_URL=https://api.mylimobiz.com
LA_CLIENT_ID=
LA_CLIENT_SECRET=
LA_COMPANY_ALIAS=
LA_PAYMENT_TYPE_ID=0                   # pick the non-charging type via manage.py la_smoke_test
LA_WEBHOOK_BASE_URL=                   # public base for LA webhooks, e.g. https://<NGROK_HOST>

# --- LocationIQ (geocoding — LA requires lat/lng on every address) ---
LOCATIONIQ_API_KEY=

# --- aviationstack (flight verification; Basic plan+ for /v1/flightsFuture; 1 req / 10 s) ---
AVIATIONSTACK_API_KEY=

# --- GNet farm-out gateway (preview mode, no sends, unless BOTH GNET_ACTIVE=True and
# GNET_API_KEY are set). The gateway is LIVE against real GNet — GNET_ACTIVE=True arms
# real bookings with a real affiliate operator, so only flip it on deliberately. ---
GNET_ACTIVE=False
GNET_GATEWAY_URL=https://lansdownedata.com
GNET_API_KEY=
GNET_CALLBACK_SECRET=

# --- Public site embeds ---
CALENDLY_URL=https://calendly.com/allprocharter/quick-chat
WEDDINGWIRE_WIDGET=

# --- Inbound capture API ---
LEAD_INBOUND_API_KEY=

# --- Touch-points / messaging ---
QUOTE_EXPIRY_DAYS_BEFORE_PICKUP=14
TOUCHPOINTS_ENABLED=False                # dev safety: off by default; enable only for local testing
COMPANY_NAME=All Pro Charter
COMPANY_PHONE=
COMPANY_EMAIL=
# Daily unpaid-deposit report recipients (comma-separated). Leave the key OUT to use COMPANY_EMAIL;
# an empty value means "send to nobody".
# DEPOSIT_REPORT_EMAILS=ops@example.com,owner@example.com
PUBLIC_BASE_URL=                       # public https base of the portal, e.g. https://<NGROK_HOST> in dev; required for touch-point quote links

# --- Email (Postmark via django-anymail) — customer quotes + confirmations ---
# One credential: your Postmark Server API Token. allprocharter.com is DKIM +
# Return-Path verified in Postmark, so reservations@allprocharter.com sends freely.
# NOTE: django-environ does NOT strip inline comments — never put a "# ..." after a
# value or it becomes part of the value.
# Dev prints to the console until EMAIL_BACKEND is set to the Anymail backend below.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
POSTMARK_SERVER_TOKEN=
DEFAULT_FROM_EMAIL=All Pro Charter <reservations@allprocharter.com>
COMPANY_EMAIL=reservations@allprocharter.com
