# All Pro Charter — Lead Manager · environment template
# Copy to .env for local dev (.env is gitignored). Set real values in the host config for prod.

# --- Django ---
DJANGO_SECRET_KEY=change-me            # gen: python -c "from django.core.management.utils import get_random_secret_key as k;print(k())"
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/New_York
DJANGO_LOG_LEVEL=INFO

# --- Database --- (SQLite is used by default in dev when unset)
# DATABASE_URL=mysql://user:password@host:3306/apc_leadmanager

# --- Celery / Redis ---
CELERY_TASK_ALWAYS_EAGER=True          # True in dev (run inline); False in prod
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Stripe (deposits + balance) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEPOSIT_PCT=50
BALANCE_CHARGE_DAYS_BEFORE=30

# --- Podium (messaging, OAuth 2.0) ---
PODIUM_CLIENT_ID=
PODIUM_CLIENT_SECRET=
PODIUM_LOCATION_ID=

# --- Zapier -> LimoAnywhere ---
ZAPIER_LEAD_HOOK_URL=

# --- Inbound capture API ---
LEAD_INBOUND_API_KEY=
